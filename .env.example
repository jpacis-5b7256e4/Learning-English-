# Copy to .env on the server. Never commit .env or a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova
# Optional. Pronunciation scores are skipped unless both are set.
# Do not fake scores from the transcript.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Required when NODE_ENV=production. Leave empty only for local practice.
APP_ACCESS_CODE=
DAILY_REQUEST_CAP=150
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://jpacis-5b7256e4.github.io
PORT=3000
# Set to 1 on Render or Railway so rate limits use the proxy client IP.
# Leave empty on your own computer.
TRUST_PROXY=
NODE_ENV=
